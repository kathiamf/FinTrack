{
"main": "expo-router/entry",
"scripts": {
"start": "expo start",
"android": "expo start --android",
"ios": "expo start --ios",
"test": "jest",
"typecheck": "tsc --noEmit",
"format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"__tests__/**/*.ts\""
},
"jest": {
"preset": "jest-expo",
"moduleNameMapper": {
"^@/(.*)$": "<rootDir>/src/$1"
}
}
}